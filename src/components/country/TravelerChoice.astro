---
interface Props {
  title?: string;
}
const { title } = Astro.props;
---
<aside class="tc-box">
  <div class="tc-head">
    <span class="tc-label">Traveler's Choice</span>
    {title && <h3 class="tc-title">{title}</h3>}
  </div>
  <div class="tc-body">
    <slot />
  </div>
</aside>

<style>
  .tc-box {
    margin: 2.5rem 0;
    padding: 22px 24px 24px;
    border-radius: 14px;
    position: relative;
    background:
      linear-gradient(135deg,
        rgba(255, 255, 255, 0.045) 0%,
        rgba(255, 255, 255, 0.015) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-family: 'DM Sans', sans-serif;
  }
  .tc-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent, #5b8fff) 0%, transparent 100%);
    border-radius: 14px 0 0 0;
  }

  .tc-head {
    margin-bottom: 14px;
  }
  .tc-label {
    display: inline-block;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent, #5b8fff);
    margin-bottom: 8px;
  }
  .tc-title {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 600;
    font-style: italic;
    color: #f0f4ff;
    line-height: 1.3;
    margin: 0;
    letter-spacing: 0.005em;
  }

  .tc-body {
    font-size: 15.5px;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.78);
  }
  .tc-body :global(p) {
    margin: 0 0 1rem;
  }
  .tc-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .tc-body :global(ol),
  .tc-body :global(ul) {
    padding-left: 0;
    margin: 0;
    list-style: none;
    counter-reset: tc-item;
  }
  .tc-body :global(ol > li),
  .tc-body :global(ul > li) {
    position: relative;
    padding: 10px 0 10px 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    counter-increment: tc-item;
  }
  .tc-body :global(ol > li:last-child),
  .tc-body :global(ul > li:last-child) {
    border-bottom: none;
  }
  .tc-body :global(ol > li::before) {
    content: counter(tc-item);
    position: absolute;
    left: 0;
    top: 10px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 15px;
    font-weight: 700;
    color: var(--accent, #5b8fff);
    border: 1px solid color-mix(in srgb, var(--accent, #5b8fff) 40%, transparent);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.2);
  }
  .tc-body :global(ul > li::before) {
    content: '✦';
    position: absolute;
    left: 8px;
    top: 10px;
    color: var(--accent, #5b8fff);
    font-size: 14px;
  }
  .tc-body :global(strong) { color: #f0f4ff; font-weight: 600; }
  .tc-body :global(a) {
    color: var(--accent, #5b8fff);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
