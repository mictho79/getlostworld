---
import { getCollection } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const allBlog = await getCollection('blog');
  const posts = allBlog.filter((p: any) => p.slug.startsWith('es/'));
  const allPosts = posts.sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return posts.map((post: any) => ({
    params: { slug: post.slug.replace(/^es\//, '') },
    props:  { post, allPosts },
  }));
}

const { post, allPosts } = Astro.props as any;
const { Content } = await post.render();
const cleanSlug = post.slug.replace(/^es\//, '');
---

<BlogPost {...post.data} slug={cleanSlug} allPosts={allPosts} lang="es">
  <Content />
</BlogPost>
