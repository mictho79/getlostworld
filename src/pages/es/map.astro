---
export const prerender = false;
import { COUNTRY_DATA as DATA_EN } from '../../lib/countryData.js';
import { getT, COUNTRY_NAMES_ES } from '../../i18n/translations';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
const _capsJson = readFileSync(resolve(process.cwd(), 'public/capitals.json'), 'utf-8');

const lang = 'es' as const;
const t = getT(lang);

const highlightParam = Astro.url.searchParams.get('highlight') || '';
const highlightSlugs = highlightParam ? highlightParam.split(',').map((s: string) => s.trim()).filter(Boolean) : [];
const fromParam = Astro.url.searchParams.get('from') || '';
const valuesParam = Astro.url.searchParams.get('values') || '';
const highlightValues = valuesParam ? valuesParam.split('|') : [];

let countryDataSrc: typeof DATA_EN = DATA_EN;
const es = await import('../../lib/countryData.es.js');
const _esData = Object.keys((es as any).COUNTRY_DATA || {}).length ? (es as any).COUNTRY_DATA : {};
countryDataSrc = { ...(DATA_EN as any), ..._esData };

// Extract just the fact field per country for the sidebar
const sidebarFacts: Record<string, string> = {};
for (const [name, data] of Object.entries(countryDataSrc as any)) {
  if ((data as any).fact) sidebarFacts[name] = (data as any).fact;
}
// Name aliases: countries.js uses different keys than countryData.js
const SIDEBAR_ALIASES: Record<string, string> = {
  'United States':     'United States of America',
  'DR Congo':          'Democratic Republic of the Congo',
  'Ivory Coast':       "Côte d'Ivoire",
  'Republic of Congo': 'Republic of the Congo',
  'Cape Verde':        'Cabo Verde',
};
for (const [cjsName, libName] of Object.entries(SIDEBAR_ALIASES)) {
  if (sidebarFacts[libName]) sidebarFacts[cjsName] = sidebarFacts[libName];
}
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mapa del mundo – Explora cada país | TerraLenses</title>
  <meta name="description" content="Mapa del mundo interactivo. Haz clic en un país para explorar sus datos, cultura, geografía y más." />
  <link rel="canonical" href="https://terralenses.com/es/map/" />
  <meta name="google-site-verification" content="jncrLZewF1YuN4wAuQFWpmCTFcOhhZjQCeyAdK03Bcc" />
  <link rel="alternate" hreflang="en" href="https://terralenses.com/map/" />
  <link rel="alternate" hreflang="fr" href="https://terralenses.com/fr/map/" />
  <link rel="alternate" hreflang="es" href="https://terralenses.com/es/map/" />
  <link rel="alternate" hreflang="x-default" href="https://terralenses.com/map/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/favicon.svg" />
  <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4020973443671350" crossorigin="anonymous"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body { width: 100%; height: 100%; overflow: hidden; font-family: 'IBM Plex Mono', monospace; background: #060f0d; }

    #sidebar { position: fixed; top: 0; left: 0; width: 300px; height: 100%; z-index: 9500; background: #080f0c; border-right: 1px solid rgba(29,158,117,0.12); display: flex; flex-direction: column; overflow: hidden; }

    #sb-welcome { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 28px 24px; transition: opacity 0.4s; }
    #sb-welcome.hidden { opacity: 0; pointer-events: none; }

    .sb-globe { font-size: 48px; margin-bottom: 4px; }
    .sb-welcome-title { font-family: 'Fraunces', Georgia, serif; font-size: 22px; font-weight: 600; color: #e8f5f0; }
    .sb-welcome-sub { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: rgba(255,255,255,0.35); margin-bottom: 12px; }

    .sb-rnk-section { width: 100%; display: flex; flex-direction: column; gap: 4px; }
    .sb-rnk-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; color: rgba(93,202,165,0.5); margin-bottom: 6px; padding-left: 2px; }
    .sb-rnk-link { display: flex; align-items: center; gap: 8px; padding: 9px 12px; border-radius: 6px; font-family: 'IBM Plex Mono', monospace; font-size: 12px; font-weight: 400; color: rgba(232,245,240,0.65); text-decoration: none; background: rgba(29,158,117,0.04); border: 1px solid rgba(29,158,117,0.12); transition: background 0.15s, color 0.15s, border-color 0.15s; }
    .sb-rnk-link:hover { background: rgba(29,158,117,0.1); color: #5DCAA5; border-color: rgba(29,158,117,0.3); }

    #sb-country { position: absolute; inset: 0; display: flex; flex-direction: column; opacity: 0; pointer-events: none; transition: opacity 0.4s; overflow-y: auto; }
    #sb-country.visible { opacity: 1; pointer-events: all; }

    #sb-accent { height: 2px; width: 100%; background: linear-gradient(90deg,#1D9E75,#5DCAA5); flex-shrink: 0; }

    #sb-banner { padding: 24px 24px 20px; display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
    #sb-flag { font-size: 44px; line-height: 1; flex-shrink: 0; }
    .sb-name-block { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    #sb-name { font-family: 'Fraunces', Georgia, serif; font-size: 28px; font-weight: 600; color: #e8f5f0; letter-spacing: 0.01em; line-height: 1.1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    #sb-region { font-family: 'Fraunces', Georgia, serif; font-size: 12px; font-style: italic; color: rgba(93,202,165,0.7); }

    .sb-divider { height: 1px; background: rgba(29,158,117,0.12); margin: 0 24px; flex-shrink: 0; }

    .sb-section-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; font-weight: 500; color: rgba(93,202,165,0.5); text-transform: uppercase; letter-spacing: 0.14em; padding: 18px 24px 8px; }

    .sb-primary-grid { display: flex; flex-direction: column; padding: 0 24px; }
    .sb-primary-stat { background: transparent; border: none; border-bottom: 1px solid rgba(29,158,117,0.1); border-radius: 0; padding: 12px 0; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 8px; margin: 0; }
    .sb-primary-stat:last-child { border-bottom: none; }
    .sb-primary-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; color: rgba(93,202,165,0.5); text-transform: uppercase; letter-spacing: 0.12em; flex-shrink: 0; }
    .sb-primary-val { font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 400; color: #e8f5f0; line-height: 1.2; text-align: right; }

    .sb-secondary-list { display: flex; flex-direction: column; padding: 0 24px; }
    .sb-secondary-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid rgba(29,158,117,0.1); }
    .sb-secondary-row:last-child { border-bottom: none; }
    .sb-secondary-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; color: rgba(93,202,165,0.5); text-transform: uppercase; letter-spacing: 0.12em; }
    .sb-secondary-val { font-family: 'IBM Plex Mono', monospace; font-size: 13px; font-weight: 400; color: #e8f5f0; text-align: right; max-width: 160px; }

    .sb-fact { margin: 20px 24px 24px; padding: 2px 0 2px 16px; border-left: 3px solid #1D9E75; flex-shrink: 0; }
    .sb-fact-label { font-family: 'IBM Plex Mono', monospace; font-size: 9px; font-weight: 500; color: rgba(93,202,165,0.5); text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 10px; display: block; }
    .sb-fact-text { font-family: 'Fraunces', Georgia, serif; font-size: 13px; font-style: italic; color: rgba(232,245,240,0.65); line-height: 1.65; }

    #map { position: fixed; top: 0; left: 300px; right: 0; bottom: 0; }
    .leaflet-container { background: #060f0d !important; }

    #map-dotgrid { position: fixed; top: 0; left: 300px; right: 0; bottom: 0; pointer-events: none; z-index: 450; background-image: radial-gradient(circle, rgba(29,158,117,0.08) 1px, transparent 1px); background-size: 24px 24px; }

    #mobile-logo { display: none; position: fixed; top: 12px; left: 12px; z-index: 9600; font-family: 'IBM Plex Mono', monospace; font-size: 11px; font-weight: 500; color: rgba(93,202,165,0.4); letter-spacing: 0.08em; background: rgba(6,15,13,0.85); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); padding: 6px 12px; border-radius: 8px; border: 1px solid rgba(29,158,117,0.2); pointer-events: none; }

    #lang-sw { position:fixed; top:14px; right:16px; z-index:9999; font-family:'IBM Plex Mono',monospace; font-size:10px; font-weight:500; background:rgba(6,15,13,0.88); backdrop-filter:blur(10px); border:1px solid rgba(29,158,117,0.2); border-radius:6px; padding:5px 10px; display:flex; gap:6px; align-items:center; letter-spacing:0.06em; }
    #lang-sw a { color:rgba(255,255,255,0.3); text-decoration:none; transition:color 0.15s; }
    #lang-sw a.active { color:#5DCAA5; }
    #lang-sw a:hover { color:#e8f5f0; }
    #lang-sw span { color:rgba(29,158,117,0.2); }

    #sb-ranking { display:none; flex-direction:column; flex:1; overflow:hidden; }
    #sb-ranking.active { display:flex; }
    .sr-header { padding:20px 20px 12px; border-bottom:1px solid rgba(29,158,117,0.12); flex-shrink:0; }
    .sr-title { font-family:'IBM Plex Mono',monospace; font-size:10px; font-weight:500; color:rgba(93,202,165,0.6); letter-spacing:0.1em; text-transform:uppercase; margin-bottom:6px; }
    .sr-back { font-family:'IBM Plex Mono',monospace; font-size:11px; color:rgba(93,202,165,0.4); text-decoration:none; }
    .sr-back:hover { color:#5DCAA5; }
    .sr-list { flex:1; overflow-y:auto; padding:6px 0 20px; scrollbar-width:thin; scrollbar-color:rgba(29,158,117,0.2) transparent; }
    .sr-list::-webkit-scrollbar { width:4px; }
    .sr-list::-webkit-scrollbar-thumb { background:rgba(29,158,117,0.2); border-radius:4px; }
    .sr-item { display:flex; align-items:center; gap:10px; padding:7px 20px; text-decoration:none; transition:background 0.1s; }
    .sr-item:hover { background:rgba(29,158,117,0.06); }
    .sr-rank { font-family:'IBM Plex Mono',monospace; font-size:11px; font-weight:500; color:rgba(93,202,165,0.3); min-width:22px; text-align:right; }
    .sr-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
    .sr-flag { font-size:17px; line-height:1; }
    .sr-name { font-family:'IBM Plex Mono',monospace; font-size:12px; color:rgba(232,245,240,0.72); font-weight:400; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }

    .leaflet-control-zoom a { background: rgba(29,158,117,0.08) !important; border: 1px solid rgba(29,158,117,0.2) !important; color: #5DCAA5 !important; font-family: 'IBM Plex Mono', monospace !important; }
    .leaflet-control-zoom a:hover { background: rgba(29,158,117,0.18) !important; color: #e8f5f0 !important; }
    .leaflet-control-zoom { border: none !important; box-shadow: none !important; }
    .leaflet-bar { border: none !important; box-shadow: none !important; }
    .leaflet-bar a { border-bottom: 1px solid rgba(29,158,117,0.15) !important; }
    .leaflet-bar a:last-child { border-bottom: none !important; }

    @media (max-width: 768px) {
      #sidebar { display: none; } #map { left: 0; } #map-dotgrid { left: 0; } #mobile-logo { display: block; }
    }

    .cap-pulse { position:relative; width:24px; height:24px; }
    .cap-dot { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:5px; height:5px; border-radius:50%; background:var(--cc); box-shadow:0 0 8px var(--cc); }
    .cap-ring { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%) scale(0.3); width:22px; height:22px; border-radius:50%; border:1.5px solid var(--cc); animation:capPulse 1.8s ease-out infinite; opacity:0; }
    @keyframes capPulse { 0% { transform:translate(-50%,-50%) scale(0.3); opacity:0.9; } 100% { transform:translate(-50%,-50%) scale(1.8); opacity:0; } }
  </style>
</head>
<body>

  <div id="mobile-logo">TerraLenses</div>

  <!-- Lang switcher -->
  <div id="lang-sw"><a href="/map/" onclick="localStorage.setItem('lang-choice','en')">EN</a><span>/</span><a href="/fr/map/" onclick="localStorage.setItem('lang-choice','fr')">FR</a><span>/</span><a href="/es/map/" class="active" onclick="localStorage.setItem('lang-choice','es')">ES</a></div>

  <aside id="sidebar">

    <div id="sb-welcome">
      <div class="sb-globe">🌍</div>
      <div class="sb-welcome-title">TerraLenses</div>
      <div class="sb-welcome-sub">Pasa el cursor sobre un país para descubrirlo</div>
      <div class="sb-rnk-section">
        <div class="sb-rnk-label">Rankings</div>
        <a class="sb-rnk-link" href="/es/rankings/largest-countries/">🌍 Países más grandes</a>
        <a class="sb-rnk-link" href="/es/rankings/most-populated/">👥 Más poblados</a>
        <a class="sb-rnk-link" href="/es/rankings/most-neighbors/">🤝 Más vecinos</a>
        <a class="sb-rnk-link" href="/es/rankings/island-nations/">🏝 Naciones insulares</a>
        <a class="sb-rnk-link" href="/es/rankings/smallest-countries/">🔬 Países más pequeños</a>
      </div>
    </div>

    <div id="sb-country">
      <div id="sb-accent"></div>

      <div id="sb-banner">
        <span id="sb-flag"></span>
        <div class="sb-name-block">
          <div id="sb-name"></div>
          <div id="sb-region"></div>
        </div>
      </div>

      <div class="sb-divider"></div>

      <div class="sb-section-label">{t.keyFacts}</div>
      <div class="sb-primary-grid">
        <div class="sb-primary-stat">
          <span class="sb-primary-label">{t.capitalLabel}</span>
          <span class="sb-primary-val" id="sb-capital">—</span>
        </div>
        <div class="sb-primary-stat">
          <span class="sb-primary-label">{t.populationLabel}</span>
          <span class="sb-primary-val" id="sb-pop">—</span>
        </div>
        <div class="sb-primary-stat">
          <span class="sb-primary-label">{t.currencyLabel}</span>
          <span class="sb-primary-val" id="sb-currency">—</span>
        </div>
        <div class="sb-primary-stat">
          <span class="sb-primary-label">{t.languageLabel}</span>
          <span class="sb-primary-val" id="sb-lang">—</span>
        </div>
      </div>

      <div class="sb-section-label" style="padding-top:20px;">{t.moreInfo}</div>
      <div class="sb-secondary-list">
        <div class="sb-secondary-row">
          <span class="sb-secondary-label">{t.areaLabel}</span>
          <span class="sb-secondary-val" id="sb-area">—</span>
        </div>
        <div class="sb-secondary-row">
          <span class="sb-secondary-label">{t.religionLabel}</span>
          <span class="sb-secondary-val" id="sb-religion">—</span>
        </div>
      </div>

      <div class="sb-fact">
        <span class="sb-fact-label">{t.didYouKnow}</span>
        <span class="sb-fact-text" id="sb-fact">—</span>
      </div>
    </div>

    <div id="sb-ranking"></div>

  </aside>

  <div id="map"></div>
  <div id="map-dotgrid"></div>

  <script set:html={`window.SIDEBAR_FACTS = ${JSON.stringify(sidebarFacts)};`}></script>
  <script set:html={`window.COUNTRY_NAMES_ES_MAP = ${JSON.stringify(COUNTRY_NAMES_ES)};`}></script>
  <script set:html={`window._CAPS=${_capsJson};`}></script>
  <script set:html={`window._HIGHLIGHT=${JSON.stringify(highlightSlugs)};window._FROM=${JSON.stringify(fromParam)};window._HL_VALUES=${JSON.stringify(highlightValues)};`}></script>
  <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script is:inline src="/topojson.min.js"></script>
  <script is:inline src="/countries.js"></script>
  <script is:inline>
    const mapEl = document.getElementById('map');
    const mapW  = mapEl.clientWidth  || window.innerWidth;
    const mapH  = mapEl.clientHeight || window.innerHeight;
    // Portrait mobile: zoom by height so world fills the screen (not tiny with gray below)
    // Desktop/landscape: zoom by width (larger dim) — same as before
    const worldZoom    = Math.log2(Math.max(mapW, mapH) * 0.86 / 256);
    const minWorldZoom = Math.log2(mapW * 0.86 / 256); // allow zooming out to full world width

    const map = L.map('map', {
      center: [40, -25],
      zoom: worldZoom,
      minZoom: minWorldZoom,
      maxZoom: 18,
      maxBounds: [[-85.06, -180], [85.06, 180]],
      maxBoundsViscosity: 1.0,
      worldCopyJump: false,
      zoomControl: true,
      attributionControl: false
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png').addTo(map);

    // ── Continent colour system (N/S America split) ────────────────
    const SOUTH_AM = new Set(['Brazil','Argentina','Colombia','Peru','Venezuela','Chile','Ecuador','Bolivia','Paraguay','Uruguay','Guyana','Suriname','Trinidad and Tobago']);
    function getRegion(info) {
      if (info.region === 'Americas') return SOUTH_AM.has(info.name) ? 'South America' : 'North America';
      return info.region;
    }
    const CONT_COLOR = {
      'Europe':{'s':'#60a5fa','f':'#60a5fa'},'Asia':{'s':'#fb923c','f':'#fb923c'},
      'Africa':{'s':'#fbbf24','f':'#fbbf24'},'North America':{'s':'#f87171','f':'#f87171'},
      'South America':{'s':'#4ade80','f':'#4ade80'},'Americas':{'s':'#4ade80','f':'#4ade80'},
      'Oceania':{'s':'#22d3ee','f':'#22d3ee'},
    };
    function getHoverStyle(info) {
      const c = CONT_COLOR[getRegion(info)] || CONT_COLOR['Europe'];
      return { weight: 0.8, color: c.s, fillColor: c.f, fillOpacity: 0.22 };
    }
    const CAP_COORDS = window._CAPS || {};
    let _capMarker = null;
    function showCapitalPulse(info) {
      removeCapitalPulse();
      const coords = CAP_COORDS[info.slug];
      if (!coords) return;
      const c = (CONT_COLOR[getRegion(info)] || CONT_COLOR['Europe']).s;
      _capMarker = L.marker(coords, {
        icon: L.divIcon({ className:'', html:`<div class="cap-pulse" style="--cc:${c}"><span class="cap-ring"></span><span class="cap-dot"></span></div>`, iconSize:[24,24], iconAnchor:[12,12] }),
        interactive:false, zIndexOffset:2000
      }).addTo(map);
    }
    function removeCapitalPulse() { if (_capMarker) { map.removeLayer(_capMarker); _capMarker = null; } }

    // ── Sidebar ───────────────────────────────────────
    const ACCENT = {
      'Europe':'linear-gradient(90deg,#3b82f6,#60a5fa)','Asia':'linear-gradient(90deg,#d97706,#fb923c)',
      'Africa':'linear-gradient(90deg,#b45309,#fbbf24)','North America':'linear-gradient(90deg,#dc2626,#f87171)',
      'South America':'linear-gradient(90deg,#16a34a,#4ade80)','Americas':'linear-gradient(90deg,#16a34a,#4ade80)',
      'Oceania':'linear-gradient(90deg,#0891b2,#22d3ee)',
    };
    const REGION_ES = { Europe:'Europa', Asia:'Asia', Africa:'África', Americas:'Américas', Oceania:'Oceanía', 'North America':'América del Norte', 'South America':'América del Sur' };

    function showCountry(info, data) {
      const nameES = (window.COUNTRY_NAMES_ES_MAP && window.COUNTRY_NAMES_ES_MAP[info.name]) || info.name;
      document.getElementById('sb-welcome').classList.add('hidden');
      document.getElementById('sb-country').classList.add('visible');
      document.getElementById('sb-accent').style.background = ACCENT[getRegion(info)] || ACCENT['Europe'];
      document.getElementById('sb-flag').textContent     = info.flag     || '';
      document.getElementById('sb-name').textContent     = nameES;
      document.getElementById('sb-region').textContent   = REGION_ES[getRegion(info)] || info.region || '';
      document.getElementById('sb-capital').textContent  = data.capital  || '—';
      document.getElementById('sb-pop').textContent      = data.pop      || '—';
      document.getElementById('sb-currency').textContent = data.currency || '—';
      document.getElementById('sb-lang').textContent     = data.lang     || '—';
      document.getElementById('sb-area').textContent     = data.area     || '—';
      document.getElementById('sb-religion').textContent = data.religion || '—';
      document.getElementById('sb-fact').textContent     = (window.SIDEBAR_FACTS && window.SIDEBAR_FACTS[info.name]) || data.fact || '—';
    }

    function showWelcome() {
      document.getElementById('sb-welcome').classList.remove('hidden');
      document.getElementById('sb-country').classList.remove('visible');
    }

    // ── Country polygons ──────────────────────────────
    let geojsonLayer;
    const featureLayers = {};
    let hoveredId = null;

    const STYLE_DEFAULT   = { weight: 0.5, color: 'rgba(0,0,0,0.2)', fill: false };
    const STYLE_HOVER     = { weight: 0.7, color: '#1D9E75',               fillColor: '#1D9E75', fillOpacity: 0.25 };
    const STYLE_SELECTED  = { weight: 1.0, color: '#5DCAA5',               fillColor: '#1D9E75', fillOpacity: 0.18 };
    const _hlSlugs = new Set(window._HIGHLIGHT || []);

    function _rankHue(i, total) {
      return Math.round(30 + (i / Math.max(total - 1, 1)) * 190);
    }
    function _rankStyle(i, total) {
      const h = _rankHue(i, total);
      return { weight: 2.5, color: `hsl(${h},85%,65%)`, fillColor: `hsl(${h},75%,55%)`, fillOpacity: 0.25 };
    }

    let _hlApplied = false;

    function buildRankingSidebar(hlArray, slugToInfo) {
      const panel = document.getElementById('sb-ranking');
      if (!panel) return;
      document.getElementById('sb-welcome').style.display = 'none';
      panel.classList.add('active');
      const FROM_LABELS = {
        'largest-countries': '30 países más grandes',
        'smallest-countries': 'Países más pequeños',
        'most-populated':    'Más poblados',
        'most-neighbors':    'Más vecinos',
        'island-nations':    'Naciones insulares',
      };
      const title = FROM_LABELS[window._FROM] || hlArray.length + ' países';
      const linkUrl = window._FROM ? `/es/rankings/${window._FROM}/` : '/es/rankings/';
      const values = window._HL_VALUES || [];
      const total = hlArray.length;
      let items = '';
      for (let i = 0; i < total; i++) {
        const slug = hlArray[i];
        const info = slugToInfo[slug] || {};
        const h = _rankHue(i, total);
        const color = `hsl(${h},85%,65%)`;
        const cardBg = `hsla(${h},60%,40%,0.12)`;
        const cardHover = `hsla(${h},60%,40%,0.25)`;
        const nameFR = (window.COUNTRY_NAMES_ES_MAP && window.COUNTRY_NAMES_ES_MAP[info.name]) || info.name || slug;
        const value = values[i] || '';
        items +=
          `<a href="/es/country/${slug}/" style="display:flex;align-items:center;gap:9px;padding:9px 12px;text-decoration:none;margin:3px 10px;border-radius:8px;background:${cardBg};border:1px solid hsla(${h},60%,50%,0.15);" onmouseover="this.style.background='${cardHover}'" onmouseout="this.style.background='${cardBg}'">` +
            `<span style="font-size:11px;font-weight:700;color:rgba(255,255,255,0.28);min-width:18px;text-align:right;flex-shrink:0;">${i+1}</span>` +
            `<div style="width:11px;height:11px;border-radius:3px;background:${color};flex-shrink:0;box-shadow:0 0 6px ${color};"></div>` +
            `<span style="font-size:20px;line-height:1;flex-shrink:0;">${info.flag||''}</span>` +
            `<div style="display:flex;flex-direction:column;gap:2px;min-width:0;flex:1;overflow:hidden;">` +
              `<span style="font-size:13px;font-weight:500;color:#e2e8f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${nameFR}</span>` +
              (value ? `<span style="font-size:11px;color:rgba(255,255,255,0.42);font-variant-numeric:tabular-nums;">${value}</span>` : '') +
            `</div>` +
          `</a>`;
      }
      panel.innerHTML =
        `<div style="padding:14px 14px 10px;flex-shrink:0;border-bottom:1px solid rgba(255,255,255,0.06);">` +
          `<div style="font-size:13px;font-weight:600;color:#fff;margin-bottom:5px;">${title}</div>` +
          `<a href="${linkUrl}" style="font-size:11px;color:rgba(255,255,255,0.4);text-decoration:none;">← Ver la lista</a>` +
        `</div>` +
        `<div style="flex:1;overflow-y:auto;padding:6px 0 16px;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,0.12) transparent;">${items}</div>`;
    }

    function applyHighlights() {
      if (_hlSlugs.size === 0) return;
      const hlArray = window._HIGHLIGHT || [];
      const total = hlArray.length;
      const slugToId = {};
      const slugToInfo = {};
      for (const [id, info] of Object.entries(COUNTRY_ID_MAP)) {
        const pid = id.padStart(3, '0'); // world-atlas uses zero-padded 3-digit string IDs
        slugToId[info.slug] = pid;
        slugToInfo[info.slug] = info;
      }
      for (const [slug, info] of Object.entries(UK_NATIONS_INFO)) {
        slugToId[slug] = slug;
        slugToInfo[slug] = info;
      }
      // Slug aliases: countryData keys → COUNTRY_ID_MAP slugs
      const SLUG_ALIASES = {
        'united-states-of-america':          'united-states',
        'democratic-republic-of-the-congo':  'dr-congo',
        'republic-of-the-congo':             'republic-of-congo',
        'cabo-verde':                        'cape-verde',
        'cote-divoire':                      'ivory-coast',
      };
      for (const [alias, canonical] of Object.entries(SLUG_ALIASES)) {
        if (slugToId[canonical])   slugToId[alias]   = slugToId[canonical];
        if (slugToInfo[canonical]) slugToInfo[alias]  = slugToInfo[canonical];
      }
      for (let i = 0; i < hlArray.length; i++) {
        const slug = hlArray[i];
        const fid = slugToId[slug];
        if (!fid || !featureLayers[fid]) continue;
        const style = _rankStyle(i, total);
        featureLayers[fid].forEach(l => { l.setStyle(style); l.bringToFront(); });
      }
      if (!_hlApplied) {
        buildRankingSidebar(hlArray, slugToInfo);
        _hlApplied = true;
      }
    }

    // UK constituent nations info (used instead of COUNTRY_ID_MAP for UK features)
    const UK_NATIONS_INFO = {
      'england':          { name:'Inglaterra',        slug:'england',          flag:'🏴󠁧󠁢󠁥󠁮󠁧󠁿', region:'Europe' },
      'scotland':         { name:'Escocia',           slug:'scotland',         flag:'🏴󠁧󠁢󠁳󠁣󠁴󠁿', region:'Europe' },
      'wales':            { name:'Gales',             slug:'wales',            flag:'🏴󠁧󠁢󠁷󠁬󠁳󠁿', region:'Europe' },
      'northern-ireland': { name:'Irlanda del Norte', slug:'northern-ireland', flag:'🏴󠁧󠁢󠁮󠁩󠁲󠁿', region:'Europe' },
    };

    // Fix antimeridian: SPLIT polygons that cross ±180° into two valid polygons
    // (instead of extending past 180° which renders off-screen)
    function fixAntimeridian(feature) {
      const geom = feature.geometry;
      if (!geom) return;

      // Make ring coordinates continuous, then shift so midpoint is in [-180, 180]
      function makeCont(ring) {
        const r = [ring[0].slice()];
        for (let i = 1; i < ring.length; i++) {
          let x = ring[i][0];
          const px = r[i-1][0];
          while (x - px >  180) x -= 360;
          while (px - x >  180) x += 360;
          r.push([x, ring[i][1]]);
        }
        // Shift so the ring's midpoint lands in [-180, 180]
        // (fixes rings that start near -180° and drift to e.g. -332°)
        let minX = r[0][0], maxX = r[0][0];
        for (const p of r) { if (p[0] < minX) minX = p[0]; if (p[0] > maxX) maxX = p[0]; }
        const mid = (minX + maxX) / 2;
        let shift = 0;
        while (mid + shift >  180) shift -= 360;
        while (mid + shift < -180) shift += 360;
        if (shift !== 0) for (const p of r) p[0] += shift;
        return r;
      }

      function lerp(a, b, x) {
        const t = (x - a[0]) / (b[0] - a[0]);
        return [x, a[1] + t * (b[1] - a[1])];
      }

      // Split a ring that crosses 180° into two rings both within [-180, 180]
      function splitRing(ring) {
        const c = makeCont(ring);
        const n = c.length - 1; // exclude duplicate closing pt
        let minX = c[0][0], maxX = c[0][0];
        for (const p of c) { if (p[0] < minX) minX = p[0]; if (p[0] > maxX) maxX = p[0]; }
        const thresh = maxX > 180 ? 180 : minX < -180 ? -180 : null;
        if (thresh === null) return [c]; // no antimeridian crossing

        // Find the two crossing points
        const cross = [];
        for (let i = 0; i < n; i++) {
          const a = c[i], b = c[(i+1) % n];
          if ((a[0] - thresh) * (b[0] - thresh) < 0)
            cross.push({ i, pt: lerp(a, b, thresh), entering: b[0] > thresh });
        }
        if (cross.length !== 2) {
          // Fallback: just make continuous (may extend off-screen)
          return [c];
        }
        if (!cross[0].entering) cross.reverse();
        const [eC, xC] = cross; // entering / exiting the >180° zone

        // Ring A: main part, with a straight cut at the antimeridian
        const rA = [];
        for (let i = 0; i <= eC.i; i++) rA.push(c[i].slice());
        rA.push(eC.pt.slice());   // close to antimeridian going in
        rA.push(xC.pt.slice());   // re-open from antimeridian going out
        for (let i = xC.i + 1; i < n; i++) rA.push(c[i].slice());
        rA.push(rA[0].slice());   // close ring

        // Ring B: the stub past the antimeridian, shifted back into [-180, 180]
        const shift = thresh === 180 ? -360 : 360;
        const rB = [[eC.pt[0] + shift, eC.pt[1]]];
        for (let i = eC.i + 1; i <= xC.i; i++) rB.push([c[i][0] + shift, c[i][1]]);
        rB.push([xC.pt[0] + shift, xC.pt[1]]);
        rB.push(rB[0].slice());   // close ring

        return [rA, rB];
      }

      const polys = geom.type === 'MultiPolygon' ? geom.coordinates : [geom.coordinates];
      const newPolys = [];
      for (const poly of polys) {
        const rings = splitRing(poly[0]);
        for (const r of rings) newPolys.push([r]);
      }
      feature.geometry = { type: 'MultiPolygon', coordinates: newPolys };

    }

    // Point-in-polygon (ray casting) — skips antimeridian edges (jumps > 180°)
    function ptInRing(lng, lat, ring) {
      let inside = false;
      for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
        const xi = ring[i][0], yi = ring[i][1], xj = ring[j][0], yj = ring[j][1];
        if (Math.abs(xi - xj) > 180) continue; // skip antimeridian-crossing edges
        if (((yi > lat) !== (yj > lat)) && (lng < (xj - xi) * (lat - yi) / (yj - yi) + xi))
          inside = !inside;
      }
      return inside;
    }

    // Pre-computed bboxes for fast rejection
    const featureBboxes = {};

    function ptInFeature(lng, lat, feature) {
      const bb = featureBboxes[feature.id];
      if (!bb) return false;
      // Test lng and lng+360 to handle antimeridian-normalized polygons
      for (const testLng of [lng, lng + 360]) {
        if (testLng < bb[0] || testLng > bb[2] || lat < bb[1] || lat > bb[3]) continue;
        const g = feature.geometry;
        const polys = g.type === 'MultiPolygon' ? g.coordinates : [g.coordinates];
        for (const poly of polys) {
          if (ptInRing(testLng, lat, poly[0])) return true;
        }
      }
      return false;
    }

    fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-10m.json')
      .then(r => r.json())
      .then(world => {
        const geojson = topojson.feature(world, world.objects.countries);

        // Remove UK (826) from world-atlas — replaced by the constituent nations layer below
        geojson.features = geojson.features.filter(f => String(f.id) !== '826');

        // Fix antimeridian first so Russia's ring is split into proper eastern/western halves
        // instead of spanning x=[-180,180] which makes its bbox cover the entire globe.
        geojson.features.forEach(fixAntimeridian);

        // Drop sub-polygons that are eastern-hemisphere countries with fragments
        // at very negative longitudes (e.g. Russia's tiny bits near Alaska).
        geojson.features.forEach(f => {
          if (!f.geometry || f.geometry.type !== 'MultiPolygon') return;
          const polys = f.geometry.coordinates;
          if (polys.length < 2) return;
          const ctr = p => { let s=0; for (const [x] of p[0]) s+=x; return s/p[0].length; };
          const centers = polys.map(ctr);
          const mainIdx = polys.map((p,i)=>[i,p[0].length]).sort((a,b)=>b[1]-a[1])[0][0];
          if (centers[mainIdx] > 0)
            f.geometry.coordinates = polys.filter((_,i) => centers[i] > -50);
        });

        // Build hitRings and featureBboxes from the now-fixed coordinates
        const hitRings = new Map();
        for (const f of geojson.features) {
          const g = f.geometry;
          if (!g) continue;
          const polys = g.type === 'MultiPolygon' ? g.coordinates : [g.coordinates];
          const newRings = polys.map(poly => poly[0].map(pt => [pt[0], pt[1]]));
          if (hitRings.has(f.id)) hitRings.get(f.id).push(...newRings);
          else hitRings.set(f.id, newRings);
          let [x0,y0,x1,y1] = featureBboxes[f.id] || [Infinity,Infinity,-Infinity,-Infinity];
          for (const poly of polys)
            for (const [x,y] of poly[0]) {
              if(x<x0)x0=x; if(x>x1)x1=x; if(y<y0)y0=y; if(y>y1)y1=y;
            }
          featureBboxes[f.id] = [x0,y0,x1,y1];
        }

        geojsonLayer = L.geoJSON(geojson, {
          style: STYLE_DEFAULT,
          onEachFeature: (feature, layer) => {
            // A feature ID may have multiple layers (e.g. Russia split at antimeridian)
            if (!featureLayers[feature.id]) featureLayers[feature.id] = [];
            featureLayers[feature.id].push(layer);
          }
        }).addTo(map);

        // ── Custom overlay for countries absent from world-atlas ──────────
        // Kosovo (383) is not in world-atlas; add its approximate polygon.
        const CUSTOM_FEATURES = [
          { id: '383', coordinates: [[[20.03,42.93],[20.28,42.98],[20.40,43.01],[20.50,43.08],[20.78,43.24],[20.82,43.27],[21.15,43.10],[21.55,43.03],[21.79,42.90],[21.79,42.30],[21.56,42.33],[21.30,42.15],[21.02,42.07],[20.63,42.00],[20.55,42.21],[20.34,42.43],[20.08,42.66],[20.03,42.93]]] },
        ];
        for (const cf of CUSTOM_FEATURES) {
          const ring = cf.coordinates[0];
          let x0=Infinity,x1=-Infinity,y0=Infinity,y1=-Infinity;
          for (const [x,y] of ring) { if(x<x0)x0=x;if(x>x1)x1=x;if(y<y0)y0=y;if(y>y1)y1=y; }
          featureBboxes[cf.id] = [x0,y0,x1,y1];
          hitRings.set(cf.id, [ring.map(pt=>[pt[0],pt[1]])]);
          const layer = L.geoJSON({ type:'Feature', id:cf.id, geometry:{ type:'Polygon', coordinates:cf.coordinates } }, { style: STYLE_DEFAULT });
          if (!featureLayers[cf.id]) featureLayers[cf.id] = [];
          layer.eachLayer(l => featureLayers[cf.id].push(l));
          layer.addTo(map);
          // Inject into geojson.features so the mousemove hit-test loop picks it up
          geojson.features.push({ id: cf.id, geometry: { type: 'Polygon', coordinates: cf.coordinates } });
        }
        applyHighlights();

        // ── UK constituent nations layer ─────────────────────────────────
        fetch('/uk-nations.geojson')
          .then(r => r.json())
          .then(ukData => {
            for (const f of ukData.features) {
              const id = f.properties.slug;
              f.id = id;

              // Register for hit-testing
              geojson.features.push(f);

              const geom = f.geometry;
              const polys = geom.type === 'MultiPolygon' ? geom.coordinates : [geom.coordinates];
              const rings = [];
              let x0=Infinity, x1=-Infinity, y0=Infinity, y1=-Infinity;
              for (const poly of polys) {
                rings.push(poly[0].map(pt => [pt[0], pt[1]]));
                for (const [x, y] of poly[0]) {
                  if(x<x0)x0=x; if(x>x1)x1=x; if(y<y0)y0=y; if(y>y1)y1=y;
                }
              }
              hitRings.set(id, rings);
              featureBboxes[id] = [x0, y0, x1, y1];

              // Add Leaflet layer (rendered on top of world layer)
              const layer = L.geoJSON(f, { style: STYLE_DEFAULT });
              featureLayers[id] = [];
              layer.eachLayer(l => featureLayers[id].push(l));
              layer.addTo(map);
            }
            applyHighlights();
          });

        // ── Custom hover via mousemove ────────────────────────────────────
        map.on('mousemove', (e) => {
          const { lat, lng } = e.latlng;
          let foundId = null;
          let foundArea = Infinity;
          const checkedIds = new Set();
          for (const f of geojson.features) {
            if (checkedIds.has(f.id)) continue;
            checkedIds.add(f.id);
            const bb = featureBboxes[f.id];
            if (!bb || lng < bb[0]-1 || lng > bb[2]+1 || lat < bb[1]-1 || lat > bb[3]+1) continue;
            const rings = hitRings.get(f.id);
            if (!rings) continue;
            for (const ring of rings) {
              if (ptInRing(lng, lat, ring)) {
                const area = (bb[2] - bb[0]) * (bb[3] - bb[1]);
                if (area < foundArea) { foundId = f.id; foundArea = area; }
                break;
              }
            }
          }

          if (_hlSlugs.size > 0) {
            hoveredId = foundId;
            mapEl.style.cursor = foundId ? 'pointer' : '';
            return;
          }

          if (foundId === hoveredId) return;
          if (hoveredId && featureLayers[hoveredId]) featureLayers[hoveredId].forEach(l => l.setStyle(STYLE_DEFAULT));
          hoveredId = foundId;
          if (foundId) {
            const info = COUNTRY_ID_MAP[+foundId] || UK_NATIONS_INFO[foundId];
            if (info && featureLayers[foundId]) {
              featureLayers[foundId].forEach(l => { l.setStyle(getHoverStyle(info)); l.bringToFront(); });
              showCountry(info, COUNTRY_DATA[info.name] || {});
              showCapitalPulse(info);
              mapEl.style.cursor = 'pointer';
            }
          } else {
            showWelcome();
            mapEl.style.cursor = '';
          }
        });

        map.on('mouseout', () => {
          if (_hlSlugs.size === 0) {
            if (hoveredId && featureLayers[hoveredId]) featureLayers[hoveredId].forEach(l => l.setStyle(STYLE_DEFAULT));
            removeCapitalPulse();
            showWelcome();
          }
          hoveredId = null; mapEl.style.cursor = '';
        });

        map.on('click', (e) => {
          if (window.innerWidth <= 768) {
            // Mobile: no hover state — hit-test the tap position directly
            const { lat, lng } = e.latlng;
            let foundId = null, foundArea = Infinity;
            const checkedIds = new Set();
            for (const f of geojson.features) {
              if (checkedIds.has(f.id)) continue;
              checkedIds.add(f.id);
              const bb = featureBboxes[f.id];
              if (!bb || lng < bb[0]-1 || lng > bb[2]+1 || lat < bb[1]-1 || lat > bb[3]+1) continue;
              const rings = hitRings.get(f.id);
              if (!rings) continue;
              for (const ring of rings) {
                if (ptInRing(lng, lat, ring)) {
                  const area = (bb[2] - bb[0]) * (bb[3] - bb[1]);
                  if (area < foundArea) { foundId = f.id; foundArea = area; }
                  break;
                }
              }
            }
            if (foundId) {
              const info = COUNTRY_ID_MAP[+foundId] || UK_NATIONS_INFO[foundId];
              if (info && info.slug) window.location.href = '/es/country/' + info.slug + '/';
            }
          } else {
            // Desktop: use hover state set by mousemove
            if (!hoveredId) return;
            const info = COUNTRY_ID_MAP[+hoveredId] || UK_NATIONS_INFO[hoveredId];
            if (info) window.location.href = '/es/country/' + info.slug + '/';
          }
        });
      });
  </script>

</body>
