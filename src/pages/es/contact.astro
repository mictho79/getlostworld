---
import Base from '../../layouts/Base.astro';
---
<Base
  title="Contacto — TerraLenses"
  description="Contacta con TerraLenses. Preguntas, comentarios o solicitudes de colaboración son bienvenidos."
  lang="es"
  hreflangEn="https://terralenses.com/contact/"
  hreflangFr="https://terralenses.com/fr/contact/"
  hreflangEs="https://terralenses.com/es/contact/"
>
  <main id="main-content" style="max-width:760px;margin:0 auto;padding:64px 24px 80px;">
    <h1 style="font-family:'Playfair Display',serif;font-size:36px;font-weight:700;color:#fff;margin-bottom:8px;">Contacto</h1>
    <p style="color:rgba(255,255,255,0.35);font-size:13px;margin-bottom:48px;">No dudes en escribirnos.</p>

    <section style="margin-bottom:36px;">
      <h2 style="font-size:18px;font-weight:600;color:rgba(147,197,253,0.9);margin-bottom:12px;">Contáctanos</h2>
      <p style="font-size:15px;color:rgba(255,255,255,0.55);line-height:1.75;">
        Para cualquier pregunta, comentario o solicitud de colaboración, contáctanos por correo electrónico:
      </p>
      <p style="margin-top:16px;">
        <a href="mailto:mic.thomas1334@gmail.com" style="color:#60a5fa;font-size:16px;font-weight:500;">mic.thomas1334@gmail.com</a>
      </p>
    </section>

    <section style="margin-bottom:36px;">
      <h2 style="font-size:18px;font-weight:600;color:rgba(147,197,253,0.9);margin-bottom:12px;">Acerca de TerraLenses</h2>
      <p style="font-size:15px;color:rgba(255,255,255,0.55);line-height:1.75;">
        TerraLenses es un atlas mundial interactivo que cubre 198 países — culturas, paisajes, estadísticas y comparaciones. Nuestro objetivo es hacer la geografía accesible y apasionante para todos.
      </p>
    </section>

    <p style="margin-top:48px;">
      <a href="/es/" style="color:#60a5fa;font-size:14px;text-decoration:none;">← Volver a TerraLenses</a>
    </p>
  </main>
</Base>
