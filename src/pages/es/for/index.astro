---
import Base from '../../../layouts/Base.astro';
import { USE_CASES, USE_CASE_SLUGS } from '../../../lib/useCaseData.js';

const SITE = 'https://terralenses.com';
---

<Base
  title="TerraLenses Para — Perfiles de países por uso"
  description="Encuentra el país ideal para tus necesidades. Guías para viajeros, estudiantes, expatriados, nómadas digitales, profesores e investigadores."
  lang="es"
  hreflangEn={`${SITE}/for/`}
  hreflangFr={`${SITE}/fr/for/`}
  hreflangEs={`${SITE}/es/for/`}
>
  <main id="main-content">
    <div class="for-index-container">
      <nav class="breadcrumb">
        <a href="/es/">Inicio</a><span>›</span>
        <span>Para</span>
      </nav>
      <header class="for-index-header">
        <h1>TerraLenses Para…</h1>
        <p class="for-index-intro">Datos y rankings de países adaptados a tus necesidades — ya seas viajero, estudiante, expatriado o nómada digital.</p>
      </header>
      <div class="for-index-grid">
        {USE_CASE_SLUGS.map(s => {
          const d = USE_CASES[s];
          return (
            <a href={`/es/for/${s}/`} class="for-index-card">
              <span class="for-index-emoji">{d.emoji}</span>
              <div class="for-index-card-title">{d.h1}</div>
              <p class="for-index-card-tagline">{d.tagline}</p>
            </a>
          );
        })}
      </div>
    </div>
  </main>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    .for-index-container { max-width: 960px; margin: 0 auto; padding: 40px 24px 80px; font-family: 'DM Sans', sans-serif; }
    .breadcrumb { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; font-size: 13px; color: rgba(255,255,255,0.3); margin-bottom: 32px; }
    .breadcrumb a { color: rgba(255,255,255,0.45); text-decoration: none; }
    .breadcrumb a:hover { color: rgba(255,255,255,0.75); }
    .for-index-header { margin-bottom: 48px; }
    .for-index-header h1 { font-family: 'Playfair Display', serif; font-size: clamp(2rem,4vw,3rem); font-weight: 700; color: #f0f4ff; margin: 0 0 16px; }
    .for-index-intro { font-size: 17px; color: rgba(255,255,255,0.6); line-height: 1.7; margin: 0; }
    .for-index-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
    .for-index-card { display: flex; flex-direction: column; gap: 8px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 14px; padding: 24px; text-decoration: none; transition: border-color 0.15s, background 0.15s; }
    .for-index-card:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.13); }
    .for-index-emoji { font-size: 2rem; line-height: 1; margin-bottom: 4px; }
    .for-index-card-title { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 700; color: #f0f4ff; line-height: 1.3; }
    .for-index-card-tagline { font-size: 13px; color: rgba(255,255,255,0.5); line-height: 1.5; margin: 0; }
  </style>
</Base>
