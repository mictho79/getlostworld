---
import Base from '../../../layouts/Base.astro';
import { USE_CASES, USE_CASE_SLUGS } from '../../../lib/useCaseData.js';

export function getStaticPaths() {
  return USE_CASE_SLUGS.map(slug => ({ params: { profile: slug } }));
}

const { profile } = Astro.params;
const data = USE_CASES[profile];
if (!data) return Astro.redirect('/es/');

const SITE = 'https://terralenses.com';
const enUrl = `${SITE}/for/${profile}/`;
const frUrl = `${SITE}/fr/for/${profile}/`;
const esUrl = `${SITE}/es/for/${profile}/`;

const faqSchema = JSON.stringify({
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": data.faq.map((item) => ({
    "@type": "Question", "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
});
---

<Base title={data.metaTitle} description={data.metaDescription} lang="es"
  hreflangEn={enUrl} hreflangFr={frUrl} hreflangEs={esUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
  </Fragment>
  <main id="main-content">
    <div class="uc-container">
      <nav class="breadcrumb">
        <a href="/es/">Inicio</a><span>›</span><span>Para</span><span>›</span>
        <span>{data.emoji} {profile.replace(/-/g,' ').replace(/\b\w/g,l=>l.toUpperCase())}</span>
      </nav>
      <header class="uc-hero">
        <span class="uc-emoji">{data.emoji}</span>
        <h1>{data.h1}</h1>
        <p class="uc-tagline">{data.tagline}</p>
        <p class="uc-intro">{data.intro}</p>
        <a href={`/es${data.cta.url}`} class="cta-btn">{data.cta.text} →</a>
      </header>
      <section class="use-cases-section">
        <h2>Cómo te ayuda TerraLenses</h2>
        <div class="use-cases-grid">
          {data.useCases.map((uc) => (
            <div class="uc-card">
              <span class="uc-card-icon">{uc.icon}</span>
              <h3>{uc.title}</h3>
              <p>{uc.body}</p>
              <a href={`/es${uc.link}`} class="uc-link">{uc.linkText} →</a>
            </div>
          ))}
        </div>
      </section>
      {data.featuredComparisons?.length > 0 && (
        <section class="featured-section">
          <h2>Comparaciones populares</h2>
          <div class="pills-row">
            {data.featuredComparisons.map((item) => (
              <a href={`/es${item.url}`} class="pill">{item.label}</a>
            ))}
          </div>
        </section>
      )}
      <section class="faq-section">
        <h2>Preguntas frecuentes</h2>
        <div class="faq-list">
          {data.faq.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    </div>
  </main>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    .uc-container { max-width: 960px; margin: 0 auto; padding: 40px 24px 80px; font-family: 'DM Sans', sans-serif; }
    .breadcrumb { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; font-size: 13px; color: rgba(255,255,255,0.3); margin-bottom: 40px; }
    .breadcrumb a { color: rgba(255,255,255,0.45); text-decoration: none; }
    .uc-hero { text-align: center; padding: 0 0 60px; border-bottom: 1px solid rgba(255,255,255,0.07); }
    .uc-emoji { font-size: 3rem; display: block; margin-bottom: 16px; }
    .uc-hero h1 { font-family: 'Playfair Display', serif; font-size: clamp(1.9rem,4vw,2.8rem); font-weight: 700; color: #f0f4ff; margin: 0 0 16px; line-height: 1.2; }
    .uc-tagline { font-size: 18px; font-weight: 500; color: rgba(255,255,255,0.65); margin: 0 0 14px; font-style: italic; }
    .uc-intro { font-size: 16px; color: rgba(255,255,255,0.5); line-height: 1.7; max-width: 680px; margin: 0 auto 28px; }
    .cta-btn { display: inline-block; background: #5b8fff; color: #fff; font-size: 15px; font-weight: 600; padding: 12px 28px; border-radius: 8px; text-decoration: none; }
    .cta-btn:hover { background: #4070e0; }
    .use-cases-section { padding: 56px 0 0; }
    .use-cases-section h2, .featured-section h2, .faq-section h2 { font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 700; color: #f0f4ff; margin: 0 0 28px; }
    .use-cases-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .uc-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; padding: 24px; }
    .uc-card-icon { font-size: 1.8rem; display: block; margin-bottom: 12px; }
    .uc-card h3 { font-size: 15px; font-weight: 600; color: rgba(255,255,255,0.9); margin: 0 0 10px; }
    .uc-card p { font-size: 14px; color: rgba(255,255,255,0.5); line-height: 1.6; margin: 0 0 16px; }
    .uc-link { font-size: 13px; color: #5b8fff; text-decoration: none; font-weight: 600; }
    .featured-section { padding: 48px 0 0; }
    .pills-row { display: flex; flex-wrap: wrap; gap: 10px; }
    .pill { font-size: 13px; color: rgba(255,255,255,0.7); background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 7px 16px; text-decoration: none; }
    .pill:hover { background: rgba(255,255,255,0.1); }
    .faq-section { padding: 56px 0 0; }
    .faq-list { display: flex; flex-direction: column; gap: 12px; }
    .faq-item { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; overflow: hidden; }
    .faq-item summary { font-size: 15px; font-weight: 600; color: rgba(255,255,255,0.85); padding: 18px 20px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after { content: '+'; font-size: 18px; color: rgba(255,255,255,0.3); }
    .faq-item[open] summary::after { content: '−'; }
    .faq-item p { font-size: 14px; color: rgba(255,255,255,0.55); line-height: 1.6; padding: 0 20px 18px; margin: 0; }
  </style>
</Base>
